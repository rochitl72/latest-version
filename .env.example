# ─────────────────────────────────────────────────────────────────────
# Docker Compose secrets — copy to `.env`, edit, then `docker compose up`.
#
#   cp .env.example .env
#
# `.env` is gitignored. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────

# Signs login tokens. REQUIRED (the API refuses to start in production
# without it). Generate a strong one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# First admin account, seeded on an empty database. REQUIRED — must not be
# left at the built-in default in production.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Skip the well-known "test" account on a real deployment.
SEED_TEST_USER=false

# Database credentials (used by both postgres and backend containers).
POSTGRES_USER=annoforge
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=annoforge

# Host port the web UI is published on → http://localhost:8080
WEB_PORT=8080

# Set true only when serving over HTTPS (so the auth cookie is TLS-only).
COOKIE_SECURE=false

# ─── Database access for GUI clients (optional) ──────────────────────
# Postgres is published on 127.0.0.1 only — reachable from this machine, not
# from the network. Change the host port here if 5432 is already taken.
DB_PORT=5432

# pgAdmin, only when started with:  docker compose --profile tools up -d pgadmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# ─── Where uploaded images and exports live on disk ──────────────────
# These are bind-mounted into the backend container, so they are ordinary
# folders you can open, rsync and back up — not Docker volumes.
#
# Relative paths are resolved against this file's directory. On a server,
# point them at a real data disk with room for the whole dataset:
#   STORAGE_PATH=/var/lib/rbg-studio/storage
#   EXPORT_PATH=/var/lib/rbg-studio/exports
STORAGE_PATH=./data/storage
EXPORT_PATH=./data/exports
