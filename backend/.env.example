# ─────────────────────────────────────────────────────────────────────
# RBG Annotation Studio — configuration
#
# Copy this file to `.env` in the same folder and edit. Every setting is
# optional; the defaults are tuned for local development.
#
#   cp .env.example .env
#
# `.env` is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────

# ─── Database (PostgreSQL) ───────────────────────────────────────────
# Users, projects, annotations, the audit log — everything lives here.
POSTGRES_USER=annoforge
POSTGRES_PASSWORD=annoforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=annoforge

# Overrides the five settings above. Use for a managed database.
#   postgresql+asyncpg://user:pass@host:5432/dbname
# DATABASE_URL=

# Connection pool. Defaults (20 / 40) suit a small-to-medium team. Raise for
# dozens of concurrent users; past that, put PgBouncer in front of Postgres.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ─── Environment ─────────────────────────────────────────────────────
# "development" (default) or "production". In production the app REFUSES to
# start if SECRET_KEY is unset or the built-in admin password is still in use,
# so an unsafe deploy fails loudly instead of running insecure.
ENVIRONMENT=development

# ─── Authentication ──────────────────────────────────────────────────
# Set to false ONLY for local development. With auth off, every endpoint
# is reachable by anyone who can connect to the port.
AUTH_ENABLED=true

# Seeds the first admin on an EMPTY database so you are never locked out.
# Changing these later does not affect existing accounts — manage users
# through the admin UI once you are in. The app forces a password change on
# first sign-in whenever these are still at their defaults.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=123
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# An extra plain-user account seeded alongside the admin, purely so you can try
# the app as a non-admin right away. Defaults to FALSE so a deployment can never
# accidentally ship a well-known login. Turn it on only for local development,
# and give it a real password if the machine is reachable by anyone else.
SEED_TEST_USER=false
BOOTSTRAP_TEST_USERNAME=test
BOOTSTRAP_TEST_PASSWORD=123

# Whether people can create their own accounts. When false, only an admin
# can. Self-registered users are always plain users.
ALLOW_SELF_REGISTRATION=false

# Shortest password the API accepts, enforced exactly as written in every
# environment (there is no hidden production floor). Set 0 to allow empty
# passwords. Length is the only password rule in this app — no complexity,
# reuse or expiry requirements.
#
# Raise this to 8 or more if the deployment is reachable beyond a trusted LAN.
MIN_PASSWORD_LENGTH=1

# Signs the JWTs. MUST be set in production — if it is empty a random key
# is generated per process, so every restart logs everyone out (and multiple
# workers would each have a different key). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=

# How long a login lasts, in minutes. Default is 12 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Set true once served over HTTPS so the auth cookie is never sent in clear.
COOKIE_SECURE=false

# ─── Server ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Browser origins allowed to call the API. Only needed when the frontend is
# served from a DIFFERENT origin than this backend — the production build is
# served by this same process, so same-origin setups need no change here.
# Comma-separated JSON list.
# CORS_ORIGINS=["https://studio.example.com"]

# ─── Uploads ─────────────────────────────────────────────────────────
# Largest single image accepted, in megabytes.
MAX_UPLOAD_MB=50

# Largest number of files in one upload request.
MAX_FILES_PER_UPLOAD=500

# ─── Storage & exports ───────────────────────────────────────────────
# Where "Export to Downloads" writes. Defaults to the current user's Downloads
# folder — fine for the desktop app, WRONG for a server (every user's export
# would land on the server's disk). On a deployment point this at a data volume.
# EXPORT_DIR=/var/lib/rbg-studio/exports

# Uploaded image files. Defaults inside the backend folder; on a deployment put
# them on a persistent, backed-up volume sized for your whole dataset.
#
# Layout — everything a user owns lives under their own folder, because each
# project belongs to exactly one assigned user:
#
#   storage/users/{user_id}_{username}/
#   ├── projects/{project_id}_{project_name}/
#   │   ├── images/{xx}/{uuid}.ext        original uploads, sharded by the first
#   │   │                                 two hex chars so no directory grows huge
#   │   ├── annotations/{image_id}.json   per-image backup, rewritten on every edit
#   │   └── exports/{timestamp}/          generated bundles
#   └── activity.log                      plain-text mirror of that user's actions
#
# Reassigning a project moves its whole folder to the new owner.
# STORAGE_DIR=/var/lib/rbg-studio/storage

# ─── Backups (scripts/backup.sh) ─────────────────────────────────────
# Where nightly backups are written, and how many days to keep.
# BACKUP_DIR=/var/lib/rbg-studio/backups
# RETENTION_DAYS=14
