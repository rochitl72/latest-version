# ─────────────────────────────────────────────────────────────────────
# Config for docker-compose.external-db.yml — connects to a Postgres server
# you already run, instead of starting one in Docker.
#
#   cp .env.external-db.example .env
#   nano .env
#   docker compose -f docker-compose.external-db.yml up -d --build
#
# `.env` is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────

# ── Security ───────────────────────────────────────────────────────
# Signs login tokens. REQUIRED — the API refuses to start in production
# without it. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# First admin account, seeded on an empty database. REQUIRED — must not be
# left at the built-in default in production.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Skip the well-known "test" account on a real deployment.
SEED_TEST_USER=false

# ── Your EXISTING PostgreSQL server ───────────────────────────────
# Point these at the database you already run. The user/database below must
# already exist on that server — this compose file does not create them.
#
# Option A — the individual pieces (simplest):
POSTGRES_HOST=db.your-company.internal
POSTGRES_PORT=5432
POSTGRES_USER=annoforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=annoforge

# Option B — OR set the full URL instead and leave the POSTGRES_* vars above
# blank; DATABASE_URL wins if both are set. Useful for managed/cloud Postgres
# that gives you one connection string (RDS, Cloud SQL, Supabase, etc.):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# If your Postgres requires SSL (common for managed cloud databases), add
# ?ssl=require to DATABASE_URL, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname?ssl=require

# ── Networking ─────────────────────────────────────────────────────
# The port the backend is published on (the browser calls this directly).
BACKEND_PORT=8000

# The URL the BROWSER will use to reach the backend — this host's real
# IP/domain + BACKEND_PORT above. This gets baked into the frontend's
# compiled JS at build time. NOT the Docker service name "backend".
PUBLIC_BACKEND_URL=http://YOUR-SERVER-IP:8000

# Must list the frontend's own origin so the backend's CORS policy allows
# the browser to call it cross-origin. JSON list syntax.
CORS_ORIGINS=["http://YOUR-SERVER-IP:8080"]

# Host port the web UI is published on.
WEB_PORT=8080

# Set true only when serving over HTTPS (so the auth cookie is TLS-only).
COOKIE_SECURE=false
